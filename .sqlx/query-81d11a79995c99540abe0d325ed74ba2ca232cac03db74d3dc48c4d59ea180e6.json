  "query": "\n        SELECT u.id, u.username, u.email, u.password_hash, u.is_admin, u.created_at\n        FROM user_groups ug\n        JOIN users u ON u.id = ug.user_id\n        WHERE ug.group_id = $1\n        ORDER BY u.username\n        ",
