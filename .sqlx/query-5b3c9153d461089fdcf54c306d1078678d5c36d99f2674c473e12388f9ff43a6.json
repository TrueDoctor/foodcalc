  "query": "\n            SELECT g.id, g.name, g.is_personal\n            FROM user_groups ug\n            JOIN groups g ON ug.group_id = g.id\n            WHERE ug.user_id = $1\n            ORDER BY g.is_personal DESC, g.name\n            ",
